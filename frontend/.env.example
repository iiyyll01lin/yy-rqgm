# AgentForge frontend environment variables
# Copy to .env.local and adjust as needed.

# Base URL of the AgentForge backend REST API.
NEXT_PUBLIC_API_BASE=http://localhost:8000

# Mock/fallback behavior:
#   true  -> always use built-in mock data (no network calls)
#   false -> always hit the live API (no fallback; errors surface)
#   unset -> "auto": try the live API, gracefully fall back to mock on error
# NEXT_PUBLIC_USE_MOCK=true
